<Window x:Class="_20241128___Binding_alapjai.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20241128___Binding_alapjai"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" >
            <TextBox Background="Beige" Margin="5" Height="25" Name="BeviteliMező1" Text="50"/>
            <Label Background="AliceBlue" Margin="5" Height="25" 
                   Content="{Binding Path=Text,ElementName=BeviteliMező1}"/>
            <Slider Background="AliceBlue" Margin="5" Height="25" Maximum="100" 
                    Value="{Binding Path=Text,ElementName=BeviteliMező1,Mode=TwoWay}" SmallChange="1" LargeChange="0"
                    IsSnapToTickEnabled="True"
                    TickFrequency="1"/>
            <ProgressBar Background="AliceBlue" Margin="5" Height="25" Maximum="100" 
                    Value="{Binding Path=Text,ElementName=BeviteliMező1}"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox Text="{Binding Szám1}"
                     Background="Beige" Margin="5" Height="25" Name="Szám1Textbox" />
            <Button Content="Szám1" Background="AliceBlue" 
                    Margin="5" Height="25" Click="Szám1_Click"/>
            <Button Content="Hozzáadás 1" Background="AliceBlue" 
                    Margin="5" Height="25" Click="Hozzáadás_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBox Text="{Binding Szám2, UpdateSourceTrigger=PropertyChanged}" TextChanged="Szám2_2Textbox_TextChanged"
                    Background="Beige" Margin="5" Height="25" Name="Szám2Textbox" />

            <Slider Value="{Binding Szám2}" Background="Beige" 
                    Margin="5" Height="25" Name="Szám2Slider" ValueChanged="Szám2Slider_ValueChanged"/>
            <Button Content="Szám2" Background="AliceBlue" 
                    Margin="5" Height="25" Click="Szám2_Click"/>
            <Button Content="Hozzáadás 2" Background="AliceBlue" 
                    Margin="5" Height="25" Click="Hozzáadás2_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="3" DataContext="{Binding U1}">
            <Label Content="Név:"/>
            <TextBox Name="Név" Text="{Binding Name}"/>
            <Label Content="E-mail:"/>
            <TextBox Name="Email" Text="{Binding Email}"/>
            <Button Content="User kiiratás" Background="AliceBlue" 
                Margin="5" Height="25" Click="UserKiiratás_Click"/>

            <Button Content="Név megváltoztatása" Background="AliceBlue" 
            Margin="5" Height="25" Click="NévMegváltoztatása_Click"/>
        </StackPanel>
    </Grid>
</Window>
